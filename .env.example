FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=
FREELLMAPI_STT_MODEL=whisper-large-v3-turbo
FREELLMAPI_TTS_MODEL=gemini-3.1-flash-tts-preview
FREELLMAPI_CHAT_MODEL=auto

# FDB-v3 / LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Stock FDB-v3 template selection
LK_PROVIDER=gpt_realtime

# Set only the provider keys used by the selected stock template.
# OPENAI_API_KEY is also required for the official LLM-judged evaluation.
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ULTRAVOX_API_KEY=
