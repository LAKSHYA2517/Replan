# NOTE: agent.py (the actual RePlan-wired LiveKit agent) previously
# pointed at a local freellmapi proxy (FREELLMAPI_BASE_URL=
# http://127.0.0.1:31415) -- a loopback address that only ever worked on
# the machine it was started on. The official Theme 05 guide bans this
# outright ("don't call your own servers at evaluation time") and a
# judge's machine would have nothing listening on that port anyway.
# agent.py now uses Gemini's realtime model (GOOGLE_API_KEY below) --
# a real, free-tier, externally-reachable hosted API, the same one
# already used for the FDB-v3 benchmark run. The FREELLMAPI_* variables
# below are no longer read by agent.py, or by anything else in this
# repo (grep confirms replan/agents/freellmapi.py has no other callers
# left) -- kept here only so the variables aren't silently dropped;
# that whole module is now effectively dead code, worth a look by
# whoever owns replan/agents/** (B) before the final submission.
FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
FREELLMAPI_API_KEY=
FREELLMAPI_STT_MODEL=whisper-large-v3-turbo
FREELLMAPI_TTS_MODEL=gemini-3.1-flash-tts-preview
FREELLMAPI_CHAT_MODEL=auto

# FDB-v3 / LiveKit Cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Which model agent.py's realtime session uses. Only GOOGLE_API_KEY
# (below) is required for this -- no other provider key is read by
# agent.py itself. LK_PROVIDER below is unrelated to agent.py; it only
# matters for the separate, stock FDB-v3 template (lk_agent_tool.py,
# lives in the Full-Duplex-Bench clone, not this repo) used to measure
# the uninstrumented-baseline numbers in the README.
GOOGLE_REALTIME_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
GOOGLE_VOICE=Puck
LK_PROVIDER=gemini2_5

# Path to the v3/ directory of your local clone of
# github.com/DanielLin94144/Full-Duplex-Bench (the one C9's hard gate
# already has everyone make). replan/tools/fdb_contract.py imports the
# real mock_apis.py from here so its results can never drift from what
# the official evaluator computes.
FDB_V3_PATH=

# Set only the provider keys used by the selected stock template.
# OPENAI_API_KEY is also required for the official LLM-judged evaluation.
OPENAI_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
ULTRAVOX_API_KEY=
